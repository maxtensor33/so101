<?xml version="1.0" ?>
<!-- SO101 place 场景（workflow/plan/envs.md Phase 0）：桌面 + cube（放置任务，cube + bin）。
     桌面/地板/灯光/相机定义与 reach 场景一致，仅任务物体不同。 -->
<mujoco model="so101_env_place">
  <include file="so101_env.xml"/>
  <option timestep="0.002"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="160" elevation="-20"/>
  </visual>
  <asset>
    <texture type="2d" name="desk" builtin="checker" rgb1="0.72 0.60 0.45" rgb2="0.68 0.56 0.42" width="300" height="300"/>
    <material name="desk" texture="desk" texuniform="true"/>
  </asset>
  <worldbody>
    <light pos="0.4 0 0.75" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -0.75" rgba="0.2 0.3 0.4 1" solref="0.001 1" solimp="0.99 0.999 0.0001"/>
    <geom name="table_top" type="box" material="desk" size="0.45 0.4 0.015" pos="0.3 0 -0.015" solref="0.001 1" solimp="0.99 0.999 0.0001"/>
    <geom name="table_body" type="box" material="desk" size="0.35 0.36 0.345" pos="0.3 0 -0.375"/>
    <!-- squint place item 默认: half=0.0125, 密度 200 -> 3.125g -->
    <body name="item" pos="0.3 0 0.0125">
      <freejoint name="item_free"/>
      <geom name="item_geom" type="box" size="0.0125 0.0125 0.0125" mass="0.003125" friction="0.3 0.005 0.0001" solref="0.001 1" solimp="0.99 0.999 0.0001" condim="4" rgba="0.85 0.15 0.15 1"/>
    </body>
    <!-- bin: squint 默认 bx=0.04 by=0.05 bz=0.015 thickness=0.005; reset 时逐 episode 重写 -->
    <body name="bin" pos="0.3 0.1 0.0025">
      <freejoint name="bin_free"/>
      <geom name="bin_bottom" type="box" size="0.04 0.05 0.0025" pos="0 0 0.0025" mass="0.04" friction="0.8 0.005 0.0001" solref="0.001 1" solimp="0.99 0.999 0.0001" condim="4" rgba="0.2 0.4 0.8 1"/>
      <geom name="bin_wall_px" type="box" size="0.0025 0.05 0.015" pos="0.04 0 0.015" mass="0.015" friction="0.8 0.005 0.0001" solref="0.001 1" solimp="0.99 0.999 0.0001" condim="4" rgba="0.2 0.4 0.8 1"/>
      <geom name="bin_wall_nx" type="box" size="0.0025 0.05 0.015" pos="-0.04 0 0.015" mass="0.015" friction="0.8 0.005 0.0001" solref="0.001 1" solimp="0.99 0.999 0.0001" condim="4" rgba="0.2 0.4 0.8 1"/>
      <geom name="bin_wall_py" type="box" size="0.04 0.0025 0.015" pos="0 0.05 0.015" mass="0.015" friction="0.8 0.005 0.0001" solref="0.001 1" solimp="0.99 0.999 0.0001" condim="4" rgba="0.2 0.4 0.8 1"/>
      <geom name="bin_wall_ny" type="box" size="0.04 0.0025 0.015" pos="0 -0.05 0.015" mass="0.015" friction="0.8 0.005 0.0001" solref="0.001 1" solimp="0.99 0.999 0.0001" condim="4" rgba="0.2 0.4 0.8 1"/>
    </body>
    <camera name="fixed_cam" pos="0.75 -0.65 0.75" xyaxes="0.792 0.610 0 -0.379 0.492 0.783" fovy="60"/>
  </worldbody>
</mujoco>
