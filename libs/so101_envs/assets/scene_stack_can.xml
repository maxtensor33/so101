<?xml version="1.0" ?>
<!-- SO101 stack-can 场景（squint StackCan 镜像）：桌面 + itemA 红 cube + itemB 蓝圆柱罐。
     squint 语义: item_type 只换底座 itemB（被堆的 itemA 永远是 cube）;
     can = 圆柱 r=0.0165 half_h=0.03 (squint 默认, 密度 200 -> ~10g), 蓝色, 立放。 -->
<mujoco model="so101_env_stack_can">
  <include file="so101_env.xml"/>
  <option timestep="0.002"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="160" elevation="-20"/>
  </visual>
  <asset>
    <texture type="2d" name="desk" builtin="checker" rgb1="0.72 0.60 0.45" rgb2="0.68 0.56 0.42" width="300" height="300"/>
    <material name="desk" texture="desk" texuniform="true"/>
  </asset>
  <worldbody>
    <light pos="0.4 0 0.75" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -0.75" rgba="0.2 0.3 0.4 1"/>
    <geom name="table_top" type="box" material="desk" size="0.45 0.4 0.015" pos="0.3 0 -0.015"/>
    <geom name="table_body" type="box" material="desk" size="0.35 0.36 0.345" pos="0.3 0 -0.375"/>
    <body name="itemA" pos="0.25 0 0.022">
      <freejoint name="itemA_free"/>
      <geom name="itemA_geom" type="box" size="0.022 0.022 0.022" mass="0.025" friction="1.0 0.005 0.0001" solref="0.005 1" solimp="0.95 0.99 0.0001" condim="3" rgba="0.85 0.15 0.15 1"/>
    </body>
    <body name="itemB" pos="0.25 0.12 0.03">
      <freejoint name="itemB_free"/>
      <geom name="itemB_geom" type="cylinder" size="0.0165 0.03" mass="0.01" friction="1.0 0.005 0.0001" condim="3" rgba="0.15 0.15 0.85 1"/>
    </body>
    <camera name="fixed_cam" pos="0.75 -0.65 0.75" xyaxes="0.792 0.610 0 -0.379 0.492 0.783" fovy="60"/>
  </worldbody>
</mujoco>
