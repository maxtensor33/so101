<?xml version="1.0"?>
<package format="3">
  <name>so101_bringup</name>
  <version>0.1.0</version>
  <description>SO-ARM101 demo launch: rviz + sim (none/gazebo/mujoco) + optional moveit</description>
  <maintainer email="maxtensor@163.com">maxtensor</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>so101_description</exec_depend>
  <exec_depend>so101_sim</exec_depend>
  <exec_depend>so101_moveit_config</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend condition="GZ_SIM_VERSION >= 8">ros_gz_sim</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
